---
export const prerender = false;

const code = Astro.params.code ?? '';

const leagueNames: Record<string, string> = {
  PL: 'Premier League',
  PD: 'La Liga',
  SA: 'Serie A',
  BL1: 'Bundesliga',
  FL1: 'Ligue 1',
  ELC: 'Championship',
  DED: 'Eredivisie',
  PPL: 'Primeira Liga',
  CL: 'UEFA Champions League',
  BSA: 'Campeonato Brasileiro Série A',
  CLI: 'Copa Libertadores'
};

const leagueName = leagueNames[code] ?? code;

type Match = {
  id: number;
  utcDate: string;
  status: string;
  homeTeam: {
    name: string;
    shortName?: string;
  };
  awayTeam: {
    name: string;
    shortName?: string;
  };
  score?: {
    fullTime?: {
      home?: number | null;
      away?: number | null;
    };
  };
};

let matches: Match[] = [];
let apiError = '';

try {
  const runtime = Astro.locals.runtime;

  const apiKey = runtime?.env?.FOOTBALL_DATA_API_KEY;

  if (!apiKey) {
    apiError = 'Football data API key is not available to the Worker.';
  } else {
    const response = await fetch(
      `https://api.football-data.org/v4/competitions/${encodeURIComponent(code)}/matches`,
      {
        headers: {
          'X-Auth-Token': apiKey
        }
      }
    );

    if (!response.ok) {
      apiError = `Football data service returned ${response.status}.`;
    } else {
      const data = await response.json();
      matches = Array.isArray(data.matches) ? data.matches : [];
    }
  }
} catch (error) {
  console.error('Football-data API error:', error);
  apiError = 'Unable to load football data right now.';
}

const upcomingMatches = matches
  .filter((match) => {
    const date = new Date(match.utcDate);
    return date >= new Date();
  })
  .slice(0, 8);

const recentMatches = matches
  .filter((match) => {
    const date = new Date(match.utcDate);
    return date < new Date();
  })
  .reverse()
  .slice(0, 8);

function formatDate(dateString: string) {
  return new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(new Date(dateString));
}

function formatTime(dateString: string) {
  return new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC'
  }).format(new Date(dateString));
}

function score(match: Match) {
  const home = match.score?.fullTime?.home;
  const away = match.score?.fullTime?.away;

  if (home == null || away == null) {
    return '—';
  }

  return `${home}–${away}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`${leagueName} football statistics, fixtures, results and predictions on MatchMetric.`}
    />
    <meta name="robots" content="index, follow" />
    <title>{leagueName} — Football Predictions | MatchMetric</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">M</span>
          <span class="brand-name">MatchMetric</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#predictions">Predictions</a>
          <a href="/#matches">Matches</a>
          <a href="/#leagues">Leagues</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <p class="eyebrow">COMPETITION</p>

          <h1>{leagueName}</h1>

          <p class="intro">
            Football statistics, recent form, fixtures and probability-based
            predictions for {leagueName}.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">UPCOMING</p>
              <h2>{leagueName} fixtures</h2>
            </div>
          </div>

          {apiError ? (
            <div class="notice">
              <div class="notice-mark">M</div>

              <div>
                <h3>Match data unavailable</h3>
                <p>{apiError}</p>
              </div>
            </div>
          ) : upcomingMatches.length > 0 ? (
            <div class="match-list">
              {upcomingMatches.map((match) => (
                <article class="match-card">
                  <div class="match-date">
                    <strong>{formatDate(match.utcDate)}</strong>
                    <span>{formatTime(match.utcDate)} UTC</span>
                  </div>

                  <div class="teams">
                    <strong>{match.homeTeam.name}</strong>
                    <span>vs</span>
                    <strong>{match.awayTeam.name}</strong>
                  </div>

                  <div class="match-status">
                    {match.status}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="notice">
              <div class="notice-mark">M</div>

              <div>
                <h3>No upcoming fixtures found</h3>
                <p>
                  There are currently no upcoming fixtures available for this
                  competition.
                </p>
              </div>
            </div>
          )}
        </div>
      </section>

      <section class="section recent">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">RESULTS</p>
              <h2>Recent matches</h2>
            </div>
          </div>

          {recentMatches.length > 0 ? (
            <div class="match-list">
              {recentMatches.map((match) => (
                <article class="match-card">
                  <div class="match-date">
                    <strong>{formatDate(match.utcDate)}</strong>
                  </div>

                  <div class="teams">
                    <strong>{match.homeTeam.name}</strong>
                    <span>{score(match)}</span>
                    <strong>{match.awayTeam.name}</strong>
                  </div>

                  <div class="match-status">
                    {match.status}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="notice">
              <div class="notice-mark">M</div>

              <div>
                <h3>No recent results found</h3>
                <p>
                  Recent results will appear here when football data is
                  available.
                </p>
              </div>
            </div>
          )}
        </div>
      </section>

      <section class="section markets">
        <div class="container">
          <p class="eyebrow">ANALYSIS</p>
          <h2>Prediction markets</h2>

          <div class="market-grid">
            <article>
              <span>01</span>
              <h3>Match Result</h3>
              <p>Home win, draw and away win probability.</p>
            </article>

            <article>
              <span>02</span>
              <h3>Over / Under</h3>
              <p>Goal-total probabilities based on available data.</p>
            </article>

            <article>
              <span>03</span>
              <h3>BTTS</h3>
              <p>Probability of both teams scoring.</p>
            </article>

            <article>
              <span>04</span>
              <h3>Corners</h3>
              <p>Statistical analysis of expected corner totals.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="methodology">
        <div class="container methodology-grid">
          <div>
            <p class="eyebrow">MATCHMETRIC</p>
            <h2>Data first. Predictions second.</h2>
          </div>

          <div>
            <p>
              MatchMetric uses football data, historical performance and
              statistical indicators to produce probability-based assessments.
            </p>

            <p>
              Predictions are statistical estimates, not guarantees of future
              results.
            </p>

            <a href="/#methodology">Learn about our approach →</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div>
          <strong>MatchMetric</strong>
          <p>Football statistics, predictions & match analysis.</p>
        </div>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/#methodology">Methodology</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>

      <div class="container copyright">
        © 2026 MatchMetric
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f5f5f2;
    color: #151515;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #deded9;
    backdrop-filter: blur(10px);
  }

  .header-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #111;
    text-decoration: none;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: #111;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }

  .brand-name {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #666;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  nav a:hover {
    color: #111;
  }

  .hero {
    background: #fff;
    border-bottom: 1px solid #deded9;
    padding: 90px 0;
  }

  .eyebrow {
    margin: 0 0 15px;
    color: #777773;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.7px;
  }

  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(48px, 7vw, 82px);
    line-height: 0.95;
    letter-spacing: -4px;
  }

  .intro {
    max-width: 650px;
    margin: 28px 0 0;
    color: #666;
    font-size: 17px;
    line-height: 1.7;
  }

  .section {
    padding: 80px 0;
  }

  .section-heading {
    margin-bottom: 28px;
  }

  h2 {
    margin: 0;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -1.7px;
  }

  .notice {
    max-width: 760px;
    display: flex;
    gap: 22px;
    padding: 28px;
    border: 1px solid #d8d8d3;
    background: #fff;
  }

  .notice-mark {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: #151515;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
  }

  .notice h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .notice p {
    margin: 0;
    color: #777;
    font-size: 14px;
    line-height: 1.7;
  }

  .match-list {
    border-top: 1px solid #d7d7d2;
    border-left: 1px solid #d7d7d2;
    background: #fff;
  }

  .match-card {
    min-height: 105px;
    display: grid;
    grid-template-columns: 180px 1fr 100px;
    align-items: center;
    gap: 25px;
    padding: 20px 24px;
    border-right: 1px solid #d7d7d2;
    border-bottom: 1px solid #d7d7d2;
  }

  .match-date {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .match-date strong {
    font-size: 13px;
  }

  .match-date span {
    color: #888;
    font-size: 11px;
  }

  .teams {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
  }

  .teams strong {
    font-size: 14px;
  }

  .teams strong:last-child {
    text-align: right;
  }

  .teams span {
    color: #888;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .match-status {
    color: #888;
    font-size: 10px;
    font-weight: 800;
    text-align: right;
    letter-spacing: 0.8px;
  }

  .recent {
    background: #f5f5f2;
  }

  .markets {
    background: #fff;
    border-top: 1px solid #deded9;
    border-bottom: 1px solid #deded9;
  }

  .markets > .container > h2 {
    margin-bottom: 28px;
  }

  .market-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid #d7d7d2;
    border-left: 1px solid #d7d7d2;
  }

  .market-grid article {
    min-height: 170px;
    padding: 22px;
    border-right: 1px solid #d7d7d2;
    border-bottom: 1px solid #d7d7d2;
  }

  .market-grid span {
    color: #999;
    font-size: 10px;
    font-weight: 800;
  }

  .market-grid h3 {
    margin: 45px 0 8px;
    font-size: 19px;
  }

  .market-grid p {
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
  }

  .methodology {
    padding: 90px 0;
    background: #171717;
    color: #fff;
  }

  .methodology .eyebrow {
    color: #999;
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 100px;
  }

  .methodology h2 {
    max-width: 600px;
    font-size: clamp(38px, 5vw, 58px);
  }

  .methodology-grid > div:last-child {
    padding-top: 8px;
  }

  .methodology p {
    margin: 0 0 20px;
    color: #aaa;
    font-size: 15px;
    line-height: 1.75;
  }

  .methodology a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
  }

  footer {
    background: #111;
    color: #fff;
  }

  .footer-inner {
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .footer-inner strong {
    font-size: 18px;
  }

  .footer-inner p {
    margin: 8px 0 0;
    color: #777;
    font-size: 12px;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: #aaa;
    text-decoration: none;
    font-size: 12px;
  }

  .copyright {
    padding: 18px 0;
    border-top: 1px solid #292929;
    color: #666;
    font-size: 10px;
  }

  @media (max-width: 760px) {
    .container {
      width: calc(100% - 28px);
    }

    .header-inner {
      min-height: 62px;
    }

    nav {
      display: none;
    }

    .hero {
      padding: 60px 0;
    }

    h1 {
      font-size: 50px;
      letter-spacing: -2.5px;
    }

    .intro {
      font-size: 15px;
    }

    .section {
      padding: 58px 0;
    }

    h2 {
      font-size: 30px;
    }

    .notice {
      padding: 22px;
      flex-direction: column;
    }

    .match-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .teams {
      gap: 10px;
    }

    .match-status {
      text-align: left;
    }

    .market-grid {
      grid-template-columns: 1fr;
    }

    .methodology {
      padding: 65px 0;
    }

    .methodology-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .footer-inner {
      padding: 35px 0;
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>

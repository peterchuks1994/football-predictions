---
const predictions = [
  {
    home: 'Manchester City',
    away: 'Liverpool',
    competition: 'Premier League',
    time: '20:00',
    result: '1',
    resultProbability: '58%',
    goals: 'Over 2.5',
    goalsProbability: '64%',
    btts: 'Yes',
    bttsProbability: '61%'
  },
  {
    home: 'Real Madrid',
    away: 'Barcelona',
    competition: 'La Liga',
    time: '20:00',
    result: '1',
    resultProbability: '52%',
    goals: 'Over 2.5',
    goalsProbability: '69%',
    btts: 'Yes',
    bttsProbability: '66%'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Football predictions, match statistics and form analysis."
    />
    <title>Football Predictions & Statistics</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">FOOTBALL<span>FORM</span></a>

        <nav>
          <a href="/">Predictions</a>
          <a href="/">Matches</a>
          <a href="/">Leagues</a>
          <a href="/">Teams</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <p class="eyebrow">FOOTBALL PREDICTIONS & STATISTICS</p>

          <h1>
            Today's football<br />
            predictions
          </h1>

          <p class="intro">
            Statistical predictions for football matches around the world,
            including match results, goals and BTTS.
          </p>
        </div>
      </section>

      <section class="predictions">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">TODAY</p>
              <h2>Featured predictions</h2>
            </div>

            <a href="/">View all matches →</a>
          </div>

          <div class="match-list">
            {predictions.map((match) => (
              <article class="match-card">
                <div class="match-top">
                  <span>{match.competition}</span>
                  <span>{match.time}</span>
                </div>

                <div class="teams">
                  <strong>{match.home}</strong>
                  <span>vs</span>
                  <strong>{match.away}</strong>
                </div>

                <div class="markets">
                  <div>
                    <span>Match result</span>
                    <strong>{match.result} <small>{match.resultProbability}</small></strong>
                  </div>

                  <div>
                    <span>Goals</span>
                    <strong>{match.goals} <small>{match.goalsProbability}</small></strong>
                  </div>

                  <div>
                    <span>BTTS</span>
                    <strong>{match.btts} <small>{match.bttsProbability}</small></strong>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="why">
        <div class="container">
          <div>
            <p class="eyebrow">OUR APPROACH</p>
            <h2>Predictions backed by football data.</h2>
          </div>

          <p>
            We analyse available match data, team form and performance
            indicators to produce probability-based predictions. No
            guarantees. Just the numbers behind each assessment.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <strong>FOOTBALLFORM</strong>
        <span>Football predictions & statistics</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f7f7f5;
    color: #151515;
  }

  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    border-bottom: 1px solid #deded9;
    background: #fff;
  }

  .header-inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: #111;
    text-decoration: none;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.6px;
  }

  .brand span {
    font-weight: 400;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a,
  .section-heading a {
    color: #555;
    text-decoration: none;
    font-size: 14px;
  }

  nav a:hover,
  .section-heading a:hover {
    color: #111;
  }

  .hero {
    padding: 76px 0 68px;
    background: #fff;
    border-bottom: 1px solid #deded9;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #777;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(44px, 7vw, 78px);
    line-height: 0.98;
    letter-spacing: -3px;
  }

  .intro {
    max-width: 590px;
    margin: 25px 0 0;
    color: #666;
    font-size: 18px;
    line-height: 1.6;
  }

  .predictions {
    padding: 60px 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  h2 {
    margin: 0;
    font-size: 30px;
    letter-spacing: -1px;
  }

  .match-list {
    display: grid;
    gap: 14px;
  }

  .match-card {
    padding: 24px;
    background: #fff;
    border: 1px solid #deded9;
  }

  .match-top {
    display: flex;
    justify-content: space-between;
    color: #777;
    font-size: 12px;
  }

  .teams {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    padding: 25px 0;
    border-bottom: 1px solid #e8e8e3;
  }

  .teams strong:last-child {
    text-align: right;
  }

  .teams span {
    color: #999;
    font-size: 13px;
  }

  .markets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-top: 18px;
  }

  .markets div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .markets span {
    color: #777;
    font-size: 12px;
  }

  .markets strong {
    font-size: 13px;
  }

  .markets small {
    color: #777;
    font-weight: 400;
  }

  .why {
    padding: 65px 0;
    background: #171717;
    color: #fff;
  }

  .why .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }

  .why .eyebrow {
    color: #aaa;
  }

  .why h2 {
    font-size: 42px;
    max-width: 500px;
  }

  .why p:last-child {
    margin: 0;
    color: #bbb;
    font-size: 17px;
    line-height: 1.7;
  }

  footer {
    background: #111;
    color: #888;
  }

  .footer-inner {
    min-height: 90px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 12px;
  }

  .footer-inner strong {
    color: #fff;
    letter-spacing: 1px;
  }

  @media (max-width: 700px) {
    .header-inner {
      min-height: 58px;
    }

    nav {
      display: none;
    }

    .hero {
      padding: 54px 0 48px;
    }

    h1 {
      font-size: 48px;
      letter-spacing: -2px;
    }

    .intro {
      font-size: 16px;
    }

    .predictions {
      padding: 45px 0;
    }

    .section-heading {
      align-items: start;
      gap: 20px;
    }

    .section-heading a {
      display: none;
    }

    h2 {
      font-size: 26px;
    }

    .match-card {
      padding: 18px;
    }

    .markets {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .why {
      padding: 50px 0;
    }

    .why .container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .why h2 {
      font-size: 32px;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
